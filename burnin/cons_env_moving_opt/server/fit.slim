rec_ticks late(){
	print("recoding at cycle "+sim.cycle);
	record_phenotype(p1);
	record_genotype(p1);
	record_group_tag(p1);
	record_vars(p1);
	record_copied_val(p1);
    record_fitness(p1);
}

eff_ticks late(){
	print("recoding at cycle "+sim.cycle);
	record_effectsize(p1);
}

// last block of the tick, after the recording blocks above
shift_time:end_time late() {
	fit_ratio = mean(abs_fit) / dnorm(optimum, optimum, sqrt(Vs));
	stopped_early = fit_ratio < stop_fit_ratio;
	if (community.tick < end_time & !stopped_early) return;

	if (stopped_early) {
		print("tick "+community.tick+": mean fitness is "+fit_ratio+" of the fitness at the optimum ("+optimum+"), stopping");
		// keep the final state even if this tick is not a regular recording tick
		if (!any(rec_ticks == community.tick)) {
			record_phenotype(p1);
			record_genotype(p1);
			record_group_tag(p1);
			record_vars(p1);
			record_copied_val(p1);
			record_fitness(p1);
		}
		if (!any(eff_ticks == community.tick)) record_effectsize(p1);
	}
	cat("Elapsed: " + (clock() - start_time)); 

	print("\nrecording metadata");
	header = paste(c("n", "psi", "shift_speed", "rep", "N", "Vs", "Va0_sqrt", "optimum", "seed", "end_time", "shift_time", "maxL", "U", "stop_tick", "stopped_early", "stop_fit_ratio", "fit_ratio", "simulation_time"), sep="\t");
	values = paste(c(n, psi, shift_speed, rep, N, Vs, Va0_sqrt, optimum, asString(seed), end_time, shift_time, maxL, U, community.tick, stopped_early, stop_fit_ratio, fit_ratio, clock() - start_time), sep="\t");
	writeFile(metadata_fn, c(header, values), append=F);

	if (record_phenotype(p1, write = T)){
		print("written phenotype to "+phenotype_fn);
	}
	if (record_group_tag(p1, write = T)){
		print("written group tag to "+group_tag_fn);
	}
	if (record_genotype(p1, write = T)){
		print("written genotype to "+genotype_fn);
	}
	if (record_effectsize(p1, write = T)){
		print("written effectsize to file "+allele_fn);
	}
	if (record_copied_val(p1, write = T)){
		print("written copied values to file "+copied_val_fn);
	}
	if (record_vars(p1, write = T)){
		print("written group vars to file "+vars_fn);
	}
    if (record_fitness(p1, write = T)){
		print("written fitness to file "+fitness_fn);
	}
	sim.simulationFinished();
}

function (logical) record_phenotype(o<Subpopulation>$ p, [logical$ write = F]){
	if(!exists("phenotype_fn")){ 
		defineConstant("phenotype_fn", "phenotypes_"+ID+".tsv");
		print("no phenotype_fn supplied. using default filename: " + phenotype_fn);
	} 
    line = paste(sim.cycle, p.individuals.tagF, sep = "\t");
    defineGlobal("phenotypeLines", c(phenotypeLines, line));
	if (write) {
    	header = paste(c("generation", p.individuals.index), sep="\t");
    	return writeFile(phenotype_fn, header + "\n"+ paste(phenotypeLines, sep="\n"), append=F);
	}
    return T;
}

