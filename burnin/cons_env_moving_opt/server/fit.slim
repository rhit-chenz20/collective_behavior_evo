function (float)estimateNe_Heterozygosity(o<Subpopulation>$ subpop, [No<Chromosome>$ chromosome = NULL]){
	if (isNULL(chromosome))
	{
		if (size(sim.chromosomes) == 1)
		chromosome = sim.chromosomes;
		else
		stop("ERROR: in a multi-chrom model, a chromosome must be supplied.");
	}
	haplosomes = subpop.haplosomesForChromosomes(chromosome, includeNulls=F);
	pi = calcHeterozygosity(haplosomes);
	return pi / (4 * (U/L));
}


function (void) calculate_phenotype(o<Subpopulation>$ p){
	// evaluate and save the additive effects of QTLs
	inds = p.individuals;
	
	a = inds.sumOfMutationsOfType(m1) + 2 * sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff);
	
	shuffled = sample(inds, N, replace=F);
	phenotype = float(N);
	vars = float(N);
	copied_val = float(N);

	group_tag = 0;

	for (i in seq(0, N-n, by=n)) {
		group = shuffled[i:(i+n-1)];
        as = a[group.index];

        // phenotype for best model
        fit = dnorm(as, optimum, sqrt(Vs));
        best_fit_i = whichMax(fit);
        best_fit_a = as[best_fit_i];
        phenotype[group.index] = (1-psi) * as + psi * best_fit_a;
        copied_val[group.index] = best_fit_a;
		
		vars[group.index] = var(as);
		group.tag = group_tag;
		group_tag = group_tag+1;
	}
	
	abs_fitness = dnorm(phenotype, optimum, sqrt(Vs));
    // no fitness adjustment needed
    adj_fitness = abs_fitness;
    
	inds.fitnessScaling = adj_fitness;
	inds.tagF = phenotype;
	
	if(community.tick >= shift_time-50){
		defineGlobal("group_vars", vars);
        defineGlobal("abs_fit", abs_fitness);
		defineGlobal("copied_val", copied_val);
	}
}
