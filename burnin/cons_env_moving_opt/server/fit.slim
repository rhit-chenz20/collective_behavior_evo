initialize() {
	initializeSLiMOptions(keepPedigrees=T);

	defineCfgParam("start_time", clock()); 
    // Constant parameters
	defineCfgParam("maxL", 10000);
	defineCfgParam("U", 0.03);
	defineCfgParam("N", 1000);
	defineCfgParam("Vs", 2*N);
    defineCfgParam("seed", getSeed());
	if (exists("slimgui")){
		defineGlobal("psi", 0.2);
		defineGlobal("n", 8);
		defineGlobal("shift_speed", 0.05);
	}
    defineGlobal("L", 500);
	defineGlobal("mutToAdd_a", 0);
    defineGlobal("optimum", 0.0);

    // variable parameters
	defineCfgParam("shift_time", 10*N);
	defineCfgParam("end_time", shift_time+1000);
	// the optimum starts at 0 and moves by shift_speed every tick from shift_time on; the
	// sim stops at end_time, or earlier once mean fitness < stop_fit_ratio * fitness at the optimum
	defineCfgParam("stop_fit_ratio", 0.5);
	// recording ticks (the stop tick is also recorded if it is not one of them)
	defineConstant("rec_ticks", c(seq(shift_time-50, shift_time-6, by=5), (shift_time-5):(shift_time+9), seq(shift_time+10, end_time, by=5)));
	defineConstant("eff_ticks", c(seq(shift_time-50, shift_time-5, by=5), (shift_time-2):(shift_time+4), seq(shift_time+5, end_time, by=10)));

    // m1: genotype
	script_a = "a=sqrt(rexp(1, mu=1)); if (runif(1) < 0.5) -a; else a;";
	initializeMutationType("m1", 0.5, "s", script_a);
	m1.color = "red";
	
	initializeGenomicElementType("g1", m1, 1.0);
	initializeGenomicElement(g1, 0, maxL-1);
	initializeMutationRate(c(U/L, 0), c(L - 1, maxL - 1));
	initializeRecombinationRate(c(0.5, 0), c(L - 1, maxL - 1));
}

function (void) defineCfgParam(string$ name, lifs value) {
	if (!exists(name))
		defineConstant(name, value);
}

1 late() {
	if(exists("slimgui")){
		sim.addSubpop(1, N);
	}else{
		if(!exists("burnin_fn")){ 
			print("no burnin file found, stopping the simulation");
			sim.simulationFinished();
		} else{
			print("reading burnin from "+burnin_fn);
			sim.readFromPopulationFile(burnin_fn);

			// output data
			defineGlobal("phenotypeLines", NULL);
			defineGlobal("genotypeLines", NULL);
			defineGlobal("group_tagLines", NULL);
			defineGlobal("varsLines", NULL);
			defineGlobal("fitnessLines", NULL);
			defineGlobal("alleleLines", NULL);
			defineGlobal("copied_valLines", NULL);

			// output data keeping
			defineGlobal("group_vars", float(N));
			defineGlobal("copied_val", float(N));
			defineGlobal("abs_fit", float(N));

			print("burnin read, starting simulation at tick "+sim.cycle);
			print("shift time is "+shift_time+", shift speed is "+shift_speed+" and end time is "+end_time);
		}
	}
}

// defined before the late() that computes fitness, so each tick uses that tick's optimum
shift_time:end_time late(){
	if (community.tick == shift_time) {
		print("optimum starts moving");
		a=p1.individuals.sumOfMutationsOfType(m1)+2*sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff);
		defineConstant("Va0_sqrt", sqrt(var(a)));
	}
	// optimum = shift_speed at shift_time, 2*shift_speed one tick later, ... (not summed, so no rounding drift)
	defineGlobal("optimum", (community.tick - shift_time + 1) * shift_speed);
}

late(){
	if(community.tick % 100 == 0){
		catn("at tick "+community.tick+" with opt "+optimum);
	}
}
2: early(){
	all_muts = p1.individuals.uniqueMutations[p1.individuals.uniqueMutations.mutationType == m1];
	defineGlobal("all_uni_mut_pos", unique(all_muts.position));
}
mutationEffect(m1) { return 1.0; }

mutation(m1) {
	// mutation exist at mut.position, reject the new mutation
	if (any(all_uni_mut_pos == mut.position)){
		if (L<(maxL-1)){
			defineGlobal("mutToAdd_a", mutToAdd_a+1);
		}else{
			print("max L has reached");
			sim.simulationFinished();
		}
		return F;
	}
	return T;
}


late() {
	if(mutToAdd_a != 0){
		if (L + mutToAdd_a <= maxL){
			// within maxL
			if (length(all_uni_mut_pos) + mutToAdd_a> L){
				//extend the region
				if (length(all_uni_mut_pos) + mutToAdd_a> L) defineGlobal("L", mutToAdd_a + length(all_uni_mut_pos));
				
				p1.haplosomes.chromosome.setMutationRate(c(U/L, 0), c(L - 1, maxL - 1));
				p1.haplosomes.chromosome.setRecombinationRate(c(0.5, 0), c(L - 1, maxL - 1));
			}
			
			if (mutToAdd_a != 0){
				// add m1
				availableSites_a = setDifference(0:(L-1), all_uni_mut_pos);
				haplosomes = sample(p1.haplosomes, mutToAdd_a, replace=T);
				for (i in 0:(length(availableSites_a)-1)){
					if (i== mutToAdd_a) break;
					haplosomes[i].addNewDrawnMutation(m1, availableSites_a[i]);
				}
			}
		}else{
			print(community.tick+": max L has reached with current L="+L+" and "+(mutToAdd_a)+" new mut");
			sim.simulationFinished();
		}
		defineGlobal("mutToAdd_a", 0);
	}
	
	calculate_phenotype(p1);
}


