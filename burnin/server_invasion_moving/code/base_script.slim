// Invasion of social learners (psi > 0) into an asocial (psi = 0) population tracking an
// optimum that moves by shift_speed every tick from shift_time (the steady_tracking model).
// The population is read from a psi = 0 burnin. At invasion_tick, invasion_ind random
// individuals become social (tagL0 = T): only they copy (rule ave / fit / ext, weight psi); the
// rest keep phenotype = genotype. Social status is inherited: two social parents -> social,
// one social parent -> social with probability 1/2, none -> asocial.
// The sim stops when the social individuals are lost (0) or fixed (N), or at end_time.
// Metadata: outcome (lost / fixed / segregating), absorb_tick (-1 if neither), final_social,
// stop_tick, plus the steady_tracking fitness / steady-lag records up to the stop.
initialize() {
	initializeSLiMOptions(keepPedigrees=T);

	defineCfgParam("start_time", clock()); 
    // Constant parameters
	defineCfgParam("maxL", 10000);
	defineCfgParam("U", 0.03);
	defineCfgParam("N", 1000);
	defineCfgParam("Vs", 2*N);
    defineCfgParam("seed", getSeed());
	if (exists("slimgui")){
		defineGlobal("psi", 0.2);
		defineGlobal("n", 8);
		defineGlobal("shift_speed", 0.05);
		defineGlobal("invasion_ind", 10);
	}
    defineGlobal("L", 500);
	defineGlobal("mutToAdd_a", 0);
    defineGlobal("optimum", 0.0);

    // variable parameters
	defineCfgParam("shift_time", 10*N);
	defineCfgParam("end_time", shift_time+2000);
	// invasion: tick (>= shift_time) and number of social invaders
	defineCfgParam("invasion_tick", shift_time);
	if (invasion_tick < shift_time | invasion_tick >= end_time) stop("invasion_tick must be in [shift_time, end_time)");
	if (!exists("invasion_ind")) stop("invasion_ind (number of social invaders) must be given");
	// the optimum starts at 0 and moves by shift_speed every tick from shift_time on. Every sim
	// runs to end_time. Failure is only recorded: a tick fails the fitness check if mean fitness
	// < fail_fit_ratio * fitness at the optimum (failed to track); the metadata has failed (T/F),
	// fail_tick (first failing tick, -1 if never), fail_lag (lag then), n_fail_ticks (number of
	// failing ticks), min_fit_ratio and min_fit_tick, and fit_ratio at end_time.
	// A steady lag is recorded too and does not stop the sim either (a population that later
	// fails can hold a near-constant lag for a few hundred ticks first). Every steady_window ticks after
	// the shift, from 2*steady_window ticks on, the mean lag (optimum - mean phenotype) over the
	// last steady_window ticks is compared with the mean over the steady_window ticks before.
	// A check passes if they differ by less than steady_tol = steady_eps * shift_speed *
	// steady_window, i.e. the population advances at >= (1 - steady_eps) of the optimum's speed.
	// steady_tick is the first tick at which steady_n checks in a row have passed (-1 if never).
	// The data log has the lag every tick, so other rules can be applied afterwards.
	defineCfgParam("fail_fit_ratio", 0.1);
	defineCfgParam("steady_window", 100);
	defineCfgParam("steady_eps", 0.05);
	defineCfgParam("steady_n", 2);
	// recording ticks: dense around the invasion, then every 20 ticks (the stop tick is also
	// recorded if it is not one of them)
	defineConstant("rec_ticks", c(seq(invasion_tick-50, invasion_tick-6, by=5), (invasion_tick-5):(invasion_tick+9), seq(invasion_tick+10, end_time, by=20)));
	defineConstant("eff_ticks", c(seq(invasion_tick-50, invasion_tick-5, by=5), (invasion_tick-2):(invasion_tick+4), seq(invasion_tick+10, end_time, by=20)));

    // m1: genotype
	script_a = "a=sqrt(rexp(1, mu=1)); if (runif(1) < 0.5) -a; else a;";
	initializeMutationType("m1", 0.5, "s", script_a);
	m1.color = "red";
	
	initializeGenomicElementType("g1", m1, 1.0);
	initializeGenomicElement(g1, 0, maxL-1);
	initializeMutationRate(c(U/L, 0), c(L - 1, maxL - 1));
	initializeRecombinationRate(c(0.5, 0), c(L - 1, maxL - 1));
}

function (void) defineCfgParam(string$ name, lifs value) {
	if (!exists(name))
		defineConstant(name, value);
}

1 late() {
	if(exists("slimgui")){
		sim.addSubpop(1, N);
		p1.individuals.tagL0 = F;
	}else{
		if(!exists("burnin_fn")){ 
			print("no burnin file found, stopping the simulation");
			sim.simulationFinished();
		} else{
			print("reading burnin from "+burnin_fn);
			sim.readFromPopulationFile(burnin_fn);
			p1.individuals.tagL0 = F;   // everyone asocial until the invasion

			// output data
			defineGlobal("phenotypeLines", NULL);
			defineGlobal("genotypeLines", NULL);
			defineGlobal("group_tagLines", NULL);
			defineGlobal("alleleLines", NULL);
			defineGlobal("socialLines", NULL);

			// output data keeping
			defineGlobal("group_vars", float(N));
			defineGlobal("abs_fit", float(N));

			print("burnin read, starting simulation at tick "+sim.cycle);
			print("shift time is "+shift_time+", shift speed is "+shift_speed+" and end time is "+end_time);
		}
	}
}

// defined before the late() that computes fitness, so each tick uses that tick's optimum
shift_time:end_time late(){
	if (community.tick == shift_time) {
		print("optimum starts moving");
		a=p1.individuals.sumOfMutationsOfType(m1)+2*sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff);
		defineConstant("Va0_sqrt", sqrt(var(a)));
		// for the steady check: the lag at every tick since the shift, the last two window
		// means (NAN until the first check), passes in a row, and the first steady tick and lag
		defineConstant("steady_tol", steady_eps * shift_speed * steady_window);
		defineGlobal("lag_history", float(0));
		defineGlobal("lag_prev", NAN);
		defineGlobal("lag_last", NAN);
		defineGlobal("steady_run", 0);
		defineGlobal("steady_tick", -1);
		defineGlobal("steady_lag", NAN);
		// for the fitness check
		defineGlobal("fail_tick", -1);
		defineGlobal("fail_lag", NAN);
		defineGlobal("n_fail_ticks", 0);
		defineGlobal("min_fit_ratio", INF);
		defineGlobal("min_fit_tick", -1);
	}
	// optimum = shift_speed at shift_time, 2*shift_speed one tick later, ... (not summed, so no rounding drift)
	defineGlobal("optimum", (community.tick - shift_time + 1) * shift_speed);
}

// the invasion, before the late() that computes phenotypes, so invaders copy from this tick on
invasion_tick late() {
	invaders = sample(p1.individuals, invasion_ind, replace=F);
	invaders.tagL0 = T;
	print("invasion at tick "+community.tick+": "+invasion_ind+" social individuals (psi "+psi+")");
}

modifyChild(p1) {
	if (parent1.tagL0 & parent2.tagL0) child.tagL0 = T;
	else if (parent1.tagL0 | parent2.tagL0) child.tagL0 = runif(1) < 0.5;
	else child.tagL0 = F;
	return T;
}

late(){
	if(community.tick % 100 == 0){
		catn("at tick "+community.tick+" with opt "+optimum);
	}
}
2: early(){
	all_muts = p1.individuals.uniqueMutations[p1.individuals.uniqueMutations.mutationType == m1];
	defineGlobal("all_uni_mut_pos", unique(all_muts.position));
}
mutationEffect(m1) { return 1.0; }

mutation(m1) {
	// mutation exist at mut.position, reject the new mutation
	if (any(all_uni_mut_pos == mut.position)){
		if (L<(maxL-1)){
			defineGlobal("mutToAdd_a", mutToAdd_a+1);
		}else{
			print("max L has reached");
			sim.simulationFinished();
		}
		return F;
	}
	return T;
}


late() {
	if(mutToAdd_a != 0){
		if (L + mutToAdd_a <= maxL){
			// within maxL
			if (length(all_uni_mut_pos) + mutToAdd_a> L){
				//extend the region
				if (length(all_uni_mut_pos) + mutToAdd_a> L) defineGlobal("L", mutToAdd_a + length(all_uni_mut_pos));
				
				p1.haplosomes.chromosome.setMutationRate(c(U/L, 0), c(L - 1, maxL - 1));
				p1.haplosomes.chromosome.setRecombinationRate(c(0.5, 0), c(L - 1, maxL - 1));
			}
			
			if (mutToAdd_a != 0){
				// add m1
				availableSites_a = setDifference(0:(L-1), all_uni_mut_pos);
				haplosomes = sample(p1.haplosomes, mutToAdd_a, replace=T);
				for (i in 0:(length(availableSites_a)-1)){
					if (i== mutToAdd_a) break;
					haplosomes[i].addNewDrawnMutation(m1, availableSites_a[i]);
				}
			}
		}else{
			print(community.tick+": max L has reached with current L="+L+" and "+(mutToAdd_a)+" new mut");
			sim.simulationFinished();
		}
		defineGlobal("mutToAdd_a", 0);
	}
	
	calculate_phenotype(p1);
}


shift_time-50: early(){
	defineGlobal("last_gen_z", p1.individuals.tagF);
	defineGlobal("last_gen_g", p1.individuals.sumOfMutationsOfType(m1)+2*sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff));
}

shift_time-50 late(){
	print("logging start at cycle "+sim.cycle);
	// log results
	log = community.createLogFile(fre_output,  sep="\t", logInterval=1);
	log.addTick();
	log.addCustomColumn("optimum", "optimum;");

	log.addCustomColumn("seg_site_pop", "length(sim.mutations[sim.mutations.mutationType == m1]);");
	log.addCustomColumn("num_fixed_mut", "length(sim.substitutions);");

	log.addCustomColumn("z_opt", "optimum-mean(p1.individuals.tagF);");
	log.addCustomColumn("z_opt_closest", "optimum-max(p1.individuals.tagF);");
	log.addCustomColumn("g_opt", "optimum-mean(p1.individuals.sumOfMutationsOfType(m1) + (2 * sum(sim.substitutions.selectionCoeff)));");

	log.addCustomColumn("s", "w = p1.lifetimeReproductiveOutput; sum(w*last_gen_z)/sum(w) - mean(last_gen_z);");
	log.addCustomColumn("b_gz", "cov(last_gen_g, last_gen_z)/var(last_gen_z);");
	log.addCustomColumn("dz1_pred", "w = p1.lifetimeReproductiveOutput; s = sum(w*last_gen_z)/sum(w) - mean(last_gen_z); cov(last_gen_g, last_gen_z)/var(last_gen_z) * s;");
	log.addCustomColumn("dg_sel", "w = p1.lifetimeReproductiveOutput; sum(w*last_gen_g)/sum(w) - mean(last_gen_g);");
	log.addCustomColumn("dg_obs", "mean(p1.individuals.sumOfMutationsOfType(m1) + (2 * sum(sim.substitutions.selectionCoeff))) - mean(last_gen_g);");

	log.addCustomColumn("Ne_heterozygosity", "estimateNe_Heterozygosity(p1);"); 
	log.addCustomColumn("H", "calcHeterozygosity(p1.haplosomes);"); 
	log.addCustomColumn("PI", "calcPi(p1.haplosomes);"); 
	log.addCustomColumn("sfs", "paste(calcSFS(metric='count'), sep=',');"); 

	log.addCustomColumn("num_social_ind", "sum(p1.individuals.tagL0);");
	log.addCustomColumn("social_z_mean", "mean_or_nan(p1.individuals.tagF[p1.individuals.tagL0]);");
	log.addCustomColumn("asocial_z_mean", "mean_or_nan(p1.individuals.tagF[!p1.individuals.tagL0]);");
	log.addCustomColumn("social_g_mean", "g = p1.individuals.sumOfMutationsOfType(m1); mean_or_nan(g[p1.individuals.tagL0]) + 2 * sum(sim.substitutions.selectionCoeff);");
	log.addCustomColumn("asocial_g_mean", "g = p1.individuals.sumOfMutationsOfType(m1); mean_or_nan(g[!p1.individuals.tagL0]) + 2 * sum(sim.substitutions.selectionCoeff);");
	log.addCustomColumn("social_fitness_mean", "mean_or_nan(abs_fit[p1.individuals.tagL0]);");
	log.addCustomColumn("asocial_fitness_mean", "mean_or_nan(abs_fit[!p1.individuals.tagL0]);");
	log.addMeanSDColumns("z", "p1.individuals.tagF;");
    log.addMeanSDColumns("g", "p1.individuals.sumOfMutationsOfType(m1) + (2 * sum(sim.substitutions.selectionCoeff));");
    log.addMeanSDColumns("fitness", "abs_fit;");   
	log.addMeanSDColumns("parent_z", "mean(last_gen_z[p1.lifetimeReproductiveOutput != 0]);");
	log.addMeanSDColumns("parent_g", "mean(last_gen_g[p1.lifetimeReproductiveOutput != 0]);");
    log.addMeanSDColumns("group_vars", "group_vars;");
	log.addMeanSDColumns("num_seg", "len=c();for(i in p1.individuals){len=c(len, length(i.uniqueMutations));}; len;");
	log.addMeanSDColumns("abs_effect", "abs_eff=c();abs_sub = sum(abs(sim.substitutions.selectionCoeff)); for(i in p1.individuals){abs_eff=c(abs_eff, abs_sub + sum(abs(i.mutationsFromHaplosomes(category='all', mutType = m1).selectionCoeff)));}; abs_eff;");
	log.addMeanSDColumns("mean_abs_effect", "mean_abs_eff=c();for(i in p1.individuals){mean_abs_eff=c(mean_abs_eff, mean(abs(i.mutationsFromHaplosomes(category='all', mutType = m1).selectionCoeff)));}; mean_abs_eff;");
	log.addMeanSDColumns("mean_effect", "mean_eff=c();for(i in p1.individuals){mean_eff=c(mean_eff, mean(i.mutationsFromHaplosomes(category='all', mutType = m1).selectionCoeff));}; mean_eff;");
	
}

rec_ticks late(){
	print("recoding at cycle "+sim.cycle);
	record_phenotype(p1);
	record_genotype(p1);
	record_group_tag(p1);
	record_social(p1);
}

eff_ticks late(){
	print("recoding at cycle "+sim.cycle);
	record_effectsize(p1);
}

// last block of the tick, after the recording blocks above
shift_time:end_time late() {
	fit_ratio = mean(abs_fit) / dnorm(optimum, optimum, sqrt(Vs));
	lag_now = optimum - mean(p1.individuals.tagF);

	// fitness check: recorded only, the sim always runs to end_time
	if (fit_ratio < min_fit_ratio) {
		defineGlobal("min_fit_ratio", fit_ratio);
		defineGlobal("min_fit_tick", community.tick);
	}
	if (fit_ratio < fail_fit_ratio) {
		defineGlobal("n_fail_ticks", n_fail_ticks + 1);
		if (fail_tick < 0) {
			defineGlobal("fail_tick", community.tick);
			defineGlobal("fail_lag", lag_now);
			print("tick "+community.tick+": mean fitness is "+fit_ratio+" of the fitness at the optimum ("+optimum+"), lag "+lag_now+": failed the fitness check; continuing to end_time");
		}
	}

	// steady check, at the end of every steady_window ticks after the shift
	defineGlobal("lag_history", c(lag_history, lag_now));
	t = size(lag_history);    // ticks since the shift, this one included
	if (t >= 2 * steady_window & t % steady_window == 0) {
		defineGlobal("lag_prev", mean(lag_history[(t - 2*steady_window):(t - steady_window - 1)]));
		defineGlobal("lag_last", mean(lag_history[(t - steady_window):(t - 1)]));
		defineGlobal("steady_run", (abs(lag_last - lag_prev) < steady_tol) ? steady_run + 1 else 0);
		if (steady_tick < 0 & steady_run >= steady_n) {
			defineGlobal("steady_tick", community.tick);
			defineGlobal("steady_lag", lag_last);
			print("tick "+community.tick+": steady lag ("+steady_n+" checks in a row within "+steady_tol+"), mean lag "+lag_last+" over the last "+steady_window+" ticks, "+lag_prev+" over the "+steady_window+" before; continuing");
		}
	}

	// invasion outcome: stop as soon as the social individuals are lost or fixed
	outcome = "segregating";
	absorb_tick = -1;
	n_social = sum(p1.individuals.tagL0);
	if (community.tick >= invasion_tick) {
		if (n_social == 0) outcome = "lost";
		else if (n_social == p1.individualCount) outcome = "fixed";
		if (outcome != "segregating") absorb_tick = community.tick;
	}
	if (outcome == "segregating" & community.tick < end_time) return;

	failed = fail_tick >= 0;
	print("tick "+community.tick+": stop, invasion outcome "+outcome+" ("+n_social+" social); failed "+failed+", fail_tick "+fail_tick+", "+n_fail_ticks+" failing ticks, min fit ratio "+min_fit_ratio+"; steady_tick "+steady_tick+", last two window means "+lag_prev+", "+lag_last);
	// keep the final state even if this tick is not a regular recording tick
	if (!any(rec_ticks == community.tick)) {
		record_phenotype(p1);
		record_genotype(p1);
		record_group_tag(p1);
		record_social(p1);
	}
	if (!any(eff_ticks == community.tick)) record_effectsize(p1);
	catn("Elapsed: " + (clock() - start_time));

	print("recording metadata");
	header = paste(c("n", "psi", "shift_speed", "rep", "N", "Vs", "Va0_sqrt", "optimum", "seed", "end_time", "shift_time", "maxL", "U", "invasion_tick", "invasion_ind", "outcome", "absorb_tick", "final_social", "stop_tick", "fail_fit_ratio", "failed", "fail_tick", "fail_lag", "n_fail_ticks", "min_fit_ratio", "min_fit_tick", "fit_ratio", "steady_window", "steady_eps", "steady_n", "steady_tol", "steady_tick", "steady_lag", "lag_prev", "lag_last", "end_lag", "simulation_time"), sep="\t");
	values = paste(c(n, psi, shift_speed, rep, N, Vs, Va0_sqrt, optimum, asString(seed), end_time, shift_time, maxL, U, invasion_tick, invasion_ind, outcome, absorb_tick, n_social, community.tick, fail_fit_ratio, failed, fail_tick, fail_lag, n_fail_ticks, min_fit_ratio, min_fit_tick, fit_ratio, steady_window, steady_eps, steady_n, steady_tol, steady_tick, steady_lag, lag_prev, lag_last, lag_history[t - 1], clock() - start_time), sep="\t");
	writeFile(metadata_fn, c(header, values), append=F);

	if (record_phenotype(p1, write = T)){
		print("written phenotype to "+phenotype_fn);
	}
	if (record_group_tag(p1, write = T)){
		print("written group tag to "+group_tag_fn);
	}
	if (record_genotype(p1, write = T)){
		print("written genotype to "+genotype_fn);
	}
	if (record_effectsize(p1, write = T)){
		print("written effectsize to file "+allele_fn);
	}
	if (record_social(p1, write = T)){
		print("written social tags to "+social_fn);
	}
	sim.simulationFinished();
}

function (logical) record_phenotype(o<Subpopulation>$ p, [logical$ write = F]){
	if(!exists("phenotype_fn")){ 
		defineConstant("phenotype_fn", "phenotypes_"+ID+".tsv");
		print("no phenotype_fn supplied. using default filename: " + phenotype_fn);
	} 
    line = paste(sim.cycle, p.individuals.tagF, sep = "\t");
    if (!write) defineGlobal("phenotypeLines", c(phenotypeLines, line));  // write=T only writes
	if (write) {
    	header = paste(c("generation", p.individuals.index), sep="\t");
    	return writeFile(phenotype_fn, header + "\n"+ paste(phenotypeLines, sep="\n"), append=F);
	}
    return T;
}

// social (1) or asocial (0) per individual, same layout as the phenotype file
function (logical) record_social(o<Subpopulation>$ p, [logical$ write = F]){
	if(!exists("social_fn")){
		defineConstant("social_fn", "social_"+ID+".tsv");
		print("no social_fn supplied. using default filename: " + social_fn);
	}
    line = paste(sim.cycle, asInteger(p.individuals.tagL0), sep = "\t");
    if (!write) defineGlobal("socialLines", c(socialLines, line));  // write=T only writes
	if (write) {
    	header = paste(c("generation", p.individuals.index), sep="\t");
    	return writeFile(social_fn, header + "\n"+ paste(socialLines, sep="\n"), append=F);
	}
    return T;
}

// mean of x, or NAN when x is empty (a log column must give one value every tick)
function (float$) mean_or_nan(numeric x){
	return (size(x) == 0) ? NAN else asFloat(mean(x));
}

function (logical) record_genotype(o<Subpopulation>$ p, [logical$ write = F]){
	if(!exists("genotype_fn")){ 
		defineConstant("genotype_fn", "rec_genotype_"+ID+".tsv");
		print("no genotype_fn supplied. using default filename: " + genotype_fn);
	} 
    line = paste(sim.cycle, p.individuals.sumOfMutationsOfType(m1)+2*sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff), sep = "\t");
    if (!write) defineGlobal("genotypeLines", c(genotypeLines, line));  // write=T only writes
	if (write) {
    	header = paste(c("generation", p.individuals.index), sep="\t");
    	return writeFile(genotype_fn, header + "\n"+ paste(genotypeLines, sep="\n"), append=F);
    }
    return T;
}

function (logical) record_group_tag(o<Subpopulation>$ p, [logical$ write = F]){
	if(!exists("group_tag_fn")){ 
		defineConstant("group_tag_fn", "rec_group_tag_"+ID+".tsv");
		print("no group_tag_fn supplied. using default filename: " + group_tag_fn);
	} 
    line = paste(sim.cycle, p.individuals.tag, sep = "\t");
    if (!write) defineGlobal("group_tagLines", c(group_tagLines, line));  // write=T only writes
	if (write) {
