function (logical) record_effectsize(o<Subpopulation>$ p, [logical$ write = F]){
	// output allele-table
	gen = community.tick;
	id = c(sim.mutations[sim.mutations.mutationType == m1].id, sim.substitutions[sim.substitutions.mutationType == m1].id);
	pos = c(sim.mutations[sim.mutations.mutationType == m1].position, sim.substitutions[sim.substitutions.mutationType == m1].position);
	effect_size = c(sim.mutations[sim.mutations.mutationType == m1].selectionCoeff, sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff);
	counts = c(sim.mutationCounts(p1, sim.mutations[sim.mutations.mutationType == m1]), rep(2*p1.individualCount, length(sim.substitutions[sim.substitutions.mutationType == m1])));
	frequencies = c(sim.mutationFrequencies(p1, sim.mutations[sim.mutations.mutationType == m1]), rep(1, length(sim.substitutions[sim.substitutions.mutationType == m1])));
	isFixed = c(sim.mutations[sim.mutations.mutationType == m1].isFixed, rep(T, length(sim.substitutions[sim.substitutions.mutationType == m1])));
	originTick = c(sim.mutations[sim.mutations.mutationType == m1].originTick, sim.substitutions[sim.substitutions.mutationType == m1].originTick);
	rows = gen+ "\t"+id + "\t" + pos + "\t" + effect_size + "\t" + counts + "\t" + frequencies + "\t" + isFixed + "\t" + originTick;
	if (!write) defineGlobal("alleleLines", c(alleleLines, rows));  // write=T only writes

    if (write) {
		return writeFile(allele_fn, c("gen\tid\tposition\teffect_size\tcounts\tfrequencies\tisFixed\toriginTick\n",alleleLines), append=F);
	}
	return T;
}

function (float)estimateNe_Heterozygosity(o<Subpopulation>$ subpop, [No<Chromosome>$ chromosome = NULL]){
	if (isNULL(chromosome))
	{
		if (size(sim.chromosomes) == 1)
		chromosome = sim.chromosomes;
		else
		stop("ERROR: in a multi-chrom model, a chromosome must be supplied.");
	}
	haplosomes = subpop.haplosomesForChromosomes(chromosome, includeNulls=F);
	pi = calcHeterozygosity(haplosomes);
	return pi / (4 * (U/L));
}


function (void) calculate_phenotype(o<Subpopulation>$ p){
	// evaluate and save the additive effects of QTLs
	inds = p.individuals;
	
	a = inds.sumOfMutationsOfType(m1) + 2 * sum(sim.substitutions[sim.substitutions.mutationType == m1].selectionCoeff);
	
	shuffled = sample(inds, N, replace=F);
	phenotype = float(N);
	vars = float(N);
	copied_val = float(N);

	group_tag = 0;

	for (i in seq(0, N-n, by=n)) {
		group = shuffled[i:(i+n-1)];
        as = a[group.index];
		social_ind = group[group.tagL0];
		asocial_ind = group[!group.tagL0];

        ######PHENOTYPE_CALCULATION######
		
		vars[group.index] = var(as);
		group.tag = group_tag;
		group_tag = group_tag+1;
	}
	
	abs_fitness = dnorm(phenotype, optimum, sqrt(Vs));
    ######FITNESS_ADJUSTMENT######
    
	inds.fitnessScaling = adj_fitness;
	inds.tagF = phenotype;
	
	if(community.tick >= shift_time-50){
		defineGlobal("group_vars", vars);
        defineGlobal("abs_fit", abs_fitness);
	}
}
